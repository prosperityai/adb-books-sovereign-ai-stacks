# =============================================================================
# cluster.env.example — inputs for infra/talos/bootstrap.sh
# Book: Sovereign AI Stacks, Chapter 4
# Copy to cluster.env, fill in, and keep it out of Git (.gitignore covers *.env).
# =============================================================================

# Cluster identity
CLUSTER_NAME=sovereign-ai
# Virtual IP shared by the control-plane nodes (Talos Layer2 VIP)
CLUSTER_VIP=10.20.10.10
CLUSTER_ENDPOINT=https://10.20.10.10:6443
KUBERNETES_VERSION=1.37.1
TALOS_VERSION=v1.14.4

# Node addresses (space-separated)
CONTROL_PLANE_IPS="10.20.10.11 10.20.10.12 10.20.10.13"
GPU_WORKER_IPS="10.20.10.21 10.20.10.22"
# Interface that carries the VIP on control-plane nodes
VIP_INTERFACE=eth0
# Disk Talos installs to (CEL expression accepted by UnattendedInstallConfig)
INSTALL_DISK_SELECTOR='disk.dev_path == "/dev/nvme0n1"'

# Enclave services: no public NTP, DNS or registries exist here
NTP_SERVER=10.20.0.53
DNS_SERVER=10.20.0.53
HARBOR_HOST=harbor.enclave.internal
HARBOR_PULL_USER='robot$cluster-pull'
# Read from the secret store at run time; never write the value in this file
HARBOR_PULL_PASSWORD_FILE=/secure/harbor-cluster-pull.token
ENCLAVE_CA_FILE=/secure/enclave-ca.crt

# Image Factory schematics (computed on the connected side, see Chapter 4)
# Vanilla Talos, for control-plane nodes:
SCHEMATIC_CONTROL_PLANE=376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
# NVIDIA open kernel modules + container toolkit + fabric manager 595.91.07:
SCHEMATIC_GPU=4d457c0bf926994cfed0e1b1e7c9665c3a5edfdb27cba46c7e84be4d212cc577

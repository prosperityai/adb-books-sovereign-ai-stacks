# =============================================================================
# .env.example: every environment variable the workstation scripts and tools
# in this repository read. Copy it to .env, fill in what you use, and load
# it with `set -a; . ./.env; set +a`. .env is git-ignored. Never commit it.
#
# In-cluster services (RAG API, audit sink, eval Job, CronJobs) get their
# settings from their Kubernetes manifests and Secrets, not from this file.
# Book: Sovereign AI Stacks
# =============================================================================

# --- Cluster access (Chapters 4 and 12) -------------------------------------
KUBECONFIG=infra/talos/out/kubeconfig
TALOSCONFIG=infra/talos/out/talosconfig

# --- Chapter 1: tools/preflight/check_host.sh ---------------------------------
# Overrides the profile's default egress expectation:
# expect-open | expect-closed | ignore
EGRESS_MODE=

# --- Chapter 3: air-gap supply chain ------------------------------------------
# Passphrase of the transfer-signing key (sign_and_sbom.sh). Prefer typing it
# into a prompt (`read -rs COSIGN_PASSWORD; export COSIGN_PASSWORD`) to
# storing it here.
COSIGN_PASSWORD=
# push_model_oci.sh: 1 only for a plain-HTTP lab registry, never in the enclave.
PLAIN_HTTP=0

# --- Chapter 5: tools/bench/run_bench.sh ---------------------------------------
INPUT_LEN=2048
OUTPUT_LEN=512
PROMPTS_PER_LEVEL=200
SLO_TTFT_P95_MS=3000
SLO_TPOT_P95_MS=100
# vLLM's API key (Chapter 5); also read by ops/scripts/canary.py.
VLLM_API_KEY=

# --- Chapter 6: apps/gateway_admin/provision_keys.py ---------------------------
LITELLM_MASTER_KEY=

# --- Chapter 8: running the RAG ingestion job from a workstation ----------------
QDRANT_URL=http://qdrant.rag.svc:6333
QDRANT_API_KEY=
TEI_EMBED_URL=http://tei-bge-m3.rag.svc:8080
TEI_API_KEY=

# --- Chapter 9: platform/observability/tools/langfuse_retention.py ---------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Chapter 10: platform/security/sign_imported_images.sh -----------------------
HARBOR=harbor.enclave.internal
# Path to the enclave CA bundle, when the workstation does not trust it already.
ENCLAVE_CA=

# --- Chapter 11: evals/harness.py ---------------------------------------------------
EVAL_GATEWAY_URL=http://litellm.ai-gateway.svc:4000
EVAL_RAG_URL=http://rag-api.rag.svc:8000
EVAL_GATEWAY_KEY=
# Either a ready RAG bearer token...
EVAL_RAG_TOKEN=
# ...or Keycloak client credentials to fetch one.
EVAL_OIDC_TOKEN_URL=https://sso.enclave.internal/realms/government/protocol/openid-connect/token
EVAL_RAG_CLIENT_ID=
EVAL_RAG_CLIENT_SECRET=

# --- Chapter 12: operations scripts -------------------------------------------------
# upgrade_model.sh
GATEWAY_CHART=oci://harbor.enclave.internal/charts/litellm-helm
GATEWAY_VERSION=1.106.0
# 1 skips the Chapter 11 gate. The script sets it itself when rolling back to
# a model that already passed; never set it by hand for a new model.
SKIP_EVAL=0
# upgrade_cluster.sh: refuse to upgrade if the newest database backup is older (seconds).
MAX_BACKUP_AGE=86400
# canary.py: Prometheus (default http://127.0.0.1:9090, e.g. through a port-forward).
PROM_URL=http://127.0.0.1:9090
# qdrant_snapshot.py when run by hand (the CronJob sets these itself)
QDRANT_NODES=
WORKDIR=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

{
  "id": null,
  "uid": "tokens-by-tenant",
  "title": "Tokens by Tenant",
  "description": "Who used how much, through which key and model. Doubles as the monthly chargeback report. Book: Sovereign AI Stacks, Chapter 9.",
  "tags": ["gateway", "chargeback", "sovereign-ai"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "links": [],
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {
          "query": "label_values(litellm_total_tokens_metric_total, team_alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(litellm_total_tokens_metric_total, team_alias)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "hide": 0
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {
          "query": "label_values(litellm_total_tokens_metric_total{team_alias=~\"$team\"}, requested_model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(litellm_total_tokens_metric_total{team_alias=~\"$team\"}, requested_model)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "hide": 0
      },
      {
        "name": "price_per_mtok",
        "label": "Rate per 1M tokens",
        "type": "textbox",
        "query": "0.50",
        "current": {"text": "0.50", "value": "0.50"},
        "hide": 0,
        "description": "Internal chargeback rate agreed with finance, in the ministry's accounting currency."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Selected range",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "decimals": 0
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "decimals": 0
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed requests",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_proxy_failed_requests_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range])) / sum(increase(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Chargeback",
      "description": "Tokens in range, per million, times the rate in the 'Rate per 1M tokens' box.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "decimals": 2
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range])) / 1e6 * $price_per_mtok",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Usage over time",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens per second by tenant",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"fillOpacity": 60, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{team_alias}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Input and output tokens per second",
      "description": "Output tokens cost far more GPU time than input tokens (decode versus prefill). Watch the ratio.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_input_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "in {{team_alias}}"
        },
        {
          "refId": "B",
          "expr": "sum by (team_alias) (rate(litellm_output_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "out {{team_alias}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests per second by status",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias, status_code) (rate(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{team_alias}} {{status_code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rate-limited (429) per key",
      "description": "Expected for batch keys (Chapter 6). A chat-ui key here means users see errors.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias, api_key_alias) (rate(litellm_proxy_failed_requests_metric_total{team_alias=~\"$team\", exception_status=\"429\"}[$__rate_interval]))",
          "legendFormat": "{{api_key_alias}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 end-to-end latency by tenant",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 10, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, team_alias) (rate(litellm_request_total_latency_metric_bucket{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "{{team_alias}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 time to first token by tenant",
      "description": "",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"fillOpacity": 10, "showPoints": "never", "thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 3}]}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, team_alias) (rate(litellm_llm_api_time_to_first_token_metric_bucket{team_alias=~\"$team\", requested_model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "{{team_alias}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Chargeback report",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 14,
      "type": "table",
      "title": "Tokens and chargeback by tenant, key and model",
      "description": "Export with the panel menu (Inspect > Data > Download CSV) for the monthly chargeback. Set the time range to the billing month first.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 31, "w": 24, "h": 12},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Chargeback"},
            "properties": [{"id": "decimals", "value": 2}, {"id": "unit", "value": "none"}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Total tokens", "desc": true}],
        "footer": {"show": true, "reducer": ["sum"], "fields": ""}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias, api_key_alias, requested_model) (increase(litellm_input_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (team_alias, api_key_alias, requested_model) (increase(litellm_output_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (team_alias, api_key_alias, requested_model) (increase(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (team_alias, api_key_alias, requested_model) (increase(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=~\"$model\"}[$__range])) / 1e6 * $price_per_mtok",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "renameByName": {
              "team_alias": "Tenant",
              "api_key_alias": "Key",
              "requested_model": "Model",
              "Value #A": "Input tokens",
              "Value #B": "Output tokens",
              "Value #C": "Total tokens",
              "Value #D": "Chargeback"
            },
            "indexByName": {
              "team_alias": 0,
              "api_key_alias": 1,
              "requested_model": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6
            }
          }
        }
      ]
    }
  ]
}
